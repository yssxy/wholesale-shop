# Required in production
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-string
SITE_URL=https://www.your-domain.co.uk

# First admin account (created on first start when the database is empty)
ADMIN_EMAIL=admin@your-domain.co.uk
ADMIN_PASSWORD=choose-a-strong-password

# Where the SQLite database and uploaded images are stored
DATA_DIR=./data
PORT=3000

# Optional: email notifications to admin and buyers
ADMIN_NOTIFY_EMAIL=sales@your-domain.co.uk
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WholesaleHub <no-reply@your-domain.co.uk>"
