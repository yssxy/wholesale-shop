<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/account-nav') %>
<div class="container account-body two-col two-col-wide">
  <form action="/account/profile" method="post" class="card form-card" novalidate>
    <h2>Profile &amp; business details</h2>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="field <%= errors.name ? 'has-error' : '' %>"><label for="p-name">Your name *</label><input id="p-name" name="name" value="<%= form.name %>" autocomplete="name"><% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %></div>
      <div class="field <%= errors.email ? 'has-error' : '' %>"><label for="p-email">Email *</label><input id="p-email" type="email" name="email" value="<%= form.email %>" autocomplete="email"><% if (errors.email) { %><p class="field-error"><%= errors.email %></p><% } %></div>
      <div class="field"><label for="p-phone">Phone</label><input id="p-phone" type="tel" name="phone" value="<%= form.phone || '' %>" autocomplete="tel"></div>
      <div class="field <%= errors.business_name ? 'has-error' : '' %>"><label for="p-biz">Business name *</label><input id="p-biz" name="business_name" value="<%= form.business_name || '' %>" autocomplete="organization"><% if (errors.business_name) { %><p class="field-error"><%= errors.business_name %></p><% } %></div>
      <div class="field"><label for="p-type">Business type</label><input id="p-type" name="business_type" value="<%= form.business_type || '' %>"></div>
      <div class="field"><label for="p-vat">VAT number</label><input id="p-vat" name="vat_number" value="<%= form.vat_number || '' %>"></div>
      <div class="field field-full"><label for="p-addr">Business address</label><input id="p-addr" name="address" value="<%= form.address || '' %>" autocomplete="street-address"></div>
      <div class="field"><label for="p-post">Postcode</label><input id="p-post" name="postcode" value="<%= form.postcode || '' %>" autocomplete="postal-code"></div>
    </div>
    <button class="btn btn-primary btn-lg" type="submit">Save details</button>
    <p class="muted small">Member since <%= formatDate(form.created_at) %></p>
  </form>
  <form action="/account/password" method="post" class="card form-card" id="password">
    <h2>Change password</h2>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" name="username" value="<%= form.email %>" autocomplete="username" hidden>
    <div class="field"><label for="pw-cur">Current password</label><input id="pw-cur" type="password" name="current_password" required autocomplete="current-password"></div>
    <div class="field"><label for="pw-new">New password</label><input id="pw-new" type="password" name="new_password" minlength="8" required autocomplete="new-password"></div>
    <div class="field"><label for="pw-new2">Confirm new password</label><input id="pw-new2" type="password" name="new_password_confirm" minlength="8" required autocomplete="new-password"></div>
    <button class="btn btn-outline" type="submit">Update password</button>
  </form>
</div>
<%- include('../partials/footer') %>
