{
  "name": "wholesalehub",
  "version": "1.0.0",
  "private": true,
  "description": "WholesaleHub - B2B wholesale catalogue and make-an-offer platform",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12"
  }
}
